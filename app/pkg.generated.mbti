  time : String
}

#derive(Eq)
pub(all) enum TaskSource {
  GitHubTask
  LinearTask
  SlackTask
}

#derive(Eq)
pub(all) enum TaskStatus {
  TaskNeedsYou
  TaskInProgress
  TaskDone
}

pub(all) struct ToolChip {
  text : String
  kind : ToolChipKind
}

#derive(Eq)
pub(all) enum ToolChipKind {
  Neutral
  Amber
  Green
  Link
  Status
  Plain
}

#derive(Eq)
pub(all) enum ToolIcon {
  List
  ClaudeTool
  CodexTool
  BotTool
  LinkTool
  PlusTool
  CheckTool
  CommentTool
  PlayTool
}

pub(all) struct ToolRow {
  icon : ToolIcon
  lead : String
  chips : Array[ToolChip]
}

pub(all) struct WorkedRow {
  label : String
  body : String
  expanded : Bool
}

pub(all) struct WorkerCard {
  name : String
  kind : AgentKind
  time : String
  body : String
  focused : Bool
}

pub(all) struct Worktree {
  id : String
  name : String
  branch : String
  primary : Bool
  tab_title : String
  agents : Array[Agent]
  transcript : Array[Block]
}

